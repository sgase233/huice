# Purpose: define server-side configuration names and local development defaults.
# Load: M1 copies this to huice/.env and implements settings loading; do not commit actual values.
# Output constraint: missing mode-required values fail startup by naming the variable only; never expose secret values.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=
REDIS_URL=
CORS_ORIGINS=http://127.0.0.1:5173
MODEL_MODE=fixture
OBJECT_STORE_MODE=local
LOCAL_OBJECT_DIR=.local-objects
ADMIN_TOKEN=
DEMO_ACCESS_MODE=local
# MODEL_MODE=deepseek 时以下三项必填；fixture 模式留空即可。
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
OBS_BUCKET=
OBS_ENDPOINT=
OBS_AK=
OBS_SK=
